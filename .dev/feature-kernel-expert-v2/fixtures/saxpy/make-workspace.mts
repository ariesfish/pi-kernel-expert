// make-workspace.mts — writes a kernel_init-shaped workspace and its v2 contract
// using the extension's own code (normalizeContract + writeContractFiles), which
// is the same path kernel_contract calls after its draft gate.
//
// It exists because the fixture must stay reproducible without a live pi session:
// the contract, goal.sh, goal.checks.sh and kernel-freeze.json are generated by
// this build, not hand-written.
//
//   node make-workspace.mts --root <dir> --bench "<command>" [--check "bash check.sh"]
//
// `--root` is where the workspace is written (locally; scp it to the node). The
// commands in the contract are absolute node paths, so pass the path the
// workspace will have ON THE NODE.
import * as path from "node:path";

import { initWorkspace } from "../../../../extensions/pi-kernel-expert/workspace/layout.ts";
import {
  normalizeContract,
  writeContractFiles,
  type ContractInput,
} from "../../../../extensions/pi-kernel-expert/kernel/contract.ts";

function arg(name: string, fallback?: string): string {
  const index = process.argv.indexOf(`--${name}`);
  if (index !== -1 && index + 1 < process.argv.length) return process.argv[index + 1];
  if (fallback !== undefined) return fallback;
  console.error(`missing --${name}`);
  process.exit(2);
}

const root = path.resolve(arg("root"));
const benchmarkCommand = arg("bench");
const checkCommand = arg("check", "bash check.sh");
const refCommand = process.argv.includes("--ref")
  ? process.argv[process.argv.indexOf("--ref") + 1]
  : undefined;
const burnInMs = process.argv.includes("--burn-in-ms")
  ? Number(process.argv[process.argv.indexOf("--burn-in-ms") + 1])
  : undefined;
const clockSm = process.argv.includes("--clock-sm")
  ? Number(process.argv[process.argv.indexOf("--clock-sm") + 1])
  : undefined;
const clockMem = process.argv.includes("--clock-mem")
  ? Number(process.argv[process.argv.indexOf("--clock-mem") + 1])
  : undefined;

const input: ContractInput = {
  objective:
    "SAXPY y[i] = a*x[i] + y[i] over fp32 must match the CPU reference within atol 1e-6 on the typical, zero_block and tail data sets, at a device time the bench actually measured.",
  checkCommand,
  benchmarkCommand,
  cells: [
    {
      id: "saxpy",
      dtype: "fp32",
      groups: [
        {
          name: "typical",
          intent: "random fp32 in [-1, 1) for x and y, a=2.5; the ordinary data path",
          seed: 12345,
        },
        {
          name: "zero_block",
          intent:
            "a quarter of x is exactly zero with y non-zero; fails a zero-input fast path that stores zero instead of leaving y",
          seed: 12345,
        },
        {
          name: "tail",
          intent: "N+37 elements, so the last partial 256-thread block is exercised",
          seed: 12345,
        },
      ],
    },
  ],
  tolerance: { rtol: 1e-5, atol: 1e-6 },
  basis: "device",
  repeats: 5,
  warmup: 2,
  // The generated script protects only goal.sh/goal.checks.sh by default; this
  // fixture's real harness is check.sh plus the two sources it compiles, so the
  // contract names them (T-004's harnessGlobs rule is then live, not vacuous).
  harnessGlobs: ["goal.sh", "goal.checks.sh", "check.sh", "kernel.cu", "bench.cu", "bench_bad.py"],
  ...(clockSm === undefined ? {} : { clockLock: { sm: clockSm, mem: clockMem } }),
  ...(refCommand === undefined ? {} : { referenceCommand: refCommand }),
  ...(burnInMs === undefined ? {} : { burnInMs }),
};

const init = initWorkspace(root);
console.log(`init: created ${init.created.join(", ") || "nothing"}, existing ${init.existing.join(", ") || "none"}`);

const normalized = normalizeContract(input, { root });
if (!normalized.contract) {
  console.error("contract refused:");
  for (const error of normalized.errors) console.error(`- ${error}`);
  process.exit(1);
}
for (const warning of normalized.warnings) console.log(`warning: ${warning}`);

const written = writeContractFiles({ root, contract: normalized.contract, force: true });
if (!written.ok) {
  console.error("write refused:");
  for (const error of written.errors) console.error(`- ${error}`);
  process.exit(1);
}

console.log(`contract sha256 ${written.result.sha}`);
console.log(`written: ${written.result.written.map((file) => path.relative(root, file)).join(", ")}`);
console.log(`benchmarkCommand: ${normalized.contract.benchmarkCommand}`);
console.log(`checkCommand:     ${normalized.contract.checkCommand}`);
console.log(
  `cells/groups:     ${normalized.contract.cells
    .map((cell) => `${cell.id}[${cell.groups.map((group) => group.name).join(",")}]`)
    .join(" ")}`,
);
